root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true

[*.{cs,py}]
indent_size = 4

[*.{json,yml,uss,html}]
indent_size = 2

[*.cs]
csharp_new_line_before_open_brace = all

# This package keeps the same-line brace style of the code it patches
[Packages/com.dosker.compressor-exclusions/**.cs]
csharp_new_line_before_open_brace = none
